# Copy to .env and fill in. Every value is optional — a feature whose settings
# are missing simply reports itself as unconfigured on the Setup page rather
# than crashing a batch.
#
# .env is gitignored. Do not commit real values.

# ---------------------------------------------------------------- storage
# Where job records, staged uploads and rendered videos live. In Docker this is
# already /data/jobs and should stay on the mounted volume.
# BVG_JOBS_ROOT=/data/jobs

# Finished job folders are deleted after this many days. Now that a published
# job is purged the moment it finishes, this only governs the jobs that could
# NOT be published — Drive unconfigured, an upload failure, or one set of names
# still to go — plus folders left behind by a submit that never got as far as
# creating a job.
BVG_JOB_RETENTION_DAYS=7

# A finished job's folder is deleted as soon as its output is confirmed in
# Google Drive, instead of waiting out the retention window above. Set false to
# keep everything for the full window — the switch to reach for if a purge ever
# removes something it should not have.
# BVG_JOB_PURGE_ON_FINISH=true

# ---------------------------------------------------------------- email
# Google Workspace SMTP with an APP PASSWORD — not the account password.
# Create one at myaccount.google.com -> Security -> 2-Step Verification ->
# App passwords. 2-Step Verification must be on for that account first.
BVG_SMTP_HOST=smtp.gmail.com
BVG_SMTP_PORT=587
BVG_SMTP_USER=fliptheplot123@gmail.com
BVG_SMTP_PASSWORD=
BVG_MAIL_FROM=fliptheplot123@gmail.com
BVG_MAIL_TO=fliptheplot123@gmail.com

# ---------------------------------------------------------------- google drive
# Paste the folder URL straight from your browser — the app extracts the id and
# works out whether it is a Shared Drive or a folder inside one:
#   https://drive.google.com/drive/folders/1ab2CdEf...?usp=sharing
#
# IT MUST LIVE IN A SHARED DRIVE. A service account has no storage quota of its
# own, so a folder in a personal My Drive fails however it is shared. Shared
# Drive ids start with "0A"; plain folder ids start with "1".
BVG_DRIVE_SHARED_DRIVE_ID=

# Optional folder inside that Shared Drive to act as the root. Blank = its root.
BVG_DRIVE_ROOT_FOLDER_ID=

# Leave blank on the GCP VM — Application Default Credentials pick up the VM's
# attached service account, so there is no key file to store or rotate.
#
# ON A LAPTOP there are no default credentials, so both Drive AND Vertex AI
# fail with "default credentials were not found". Download a JSON key for the
# service account and set GOOGLE_APPLICATION_CREDENTIALS below — that single
# variable covers both, whereas this one only covers Drive.
#
# Use the SERVICE ACCOUNT key, not `gcloud auth application-default login`:
# signing in as yourself tests your own access, not the service account's, so
# it can pass locally and still fail on the VM.
BVG_DRIVE_CREDENTIALS_FILE=

# Publish as a DIFFERENT service account than the VM runs as, by impersonating
# it. Full email, e.g. video-uploads-2@PROJECT.iam.gserviceaccount.com.
#
# Drive's 750 GB per rolling 24 hours is charged PER IDENTITY, so a second
# service account has its own untouched allowance — and a brand-new one is
# unspent, which is how to publish today rather than tomorrow. Impersonation
# rather than a second key file: no long-lived secret on disk, and access is
# revoked by removing one IAM binding.
#
# Needs, once: iamcredentials.googleapis.com enabled, the VM's service account
# granted roles/iam.serviceAccountTokenCreator on this one, and this account
# added to the Shared Drive as a Content Manager. See DEPLOYMENT.md 5b-bis.
BVG_DRIVE_IMPERSONATE=

# Where publishing continues when the account above runs out of its 750 GB per
# 24 hours. Comma-separated, tried in order. Blank = no failover.
# Each address needs the token-creator binding AND Content Manager on the Shared
# Drive — see DEPLOYMENT.md 5b-bis. Use *Test Drive access* on the Setup page to
# confirm every account before a big night; an account that was never added to
# the Shared Drive makes a run fail faster, not slower.
BVG_DRIVE_IMPERSONATE_FALLBACKS=

# Local development only. Never commit this file or the key it points at.
# GOOGLE_APPLICATION_CREDENTIALS=C:/Users/you/keys/videogen-key.json

# How finished videos are published.
#
#   zip    one yt.zip and one tk.zip per output folder (the default). A
#          16,000-video night becomes ~32 archives instead of ~32,000 files.
#   files  every video as its own Drive file under batch_NN/yt/ and
#          batch_NN/tk/, the second made with a server-side copy.
#
# `files` moves the bytes once, `zip` moves them twice: a ZIP is opaque to
# files.copy, so the archive holding the long names cannot be cloned from the
# one holding the short names. Roughly 2x the upload, in exchange for folders
# you can hand to someone.
BVG_UPLOAD_MODE=zip

# In zip mode, delete an output folder's MP4s once BOTH of its archives are
# verified in Drive. Keeps a 16,000-video render from needing room for the
# videos AND every archive at the same time. Set false to keep the MP4s on the
# VM (the local ZIP fallback then still works).
BVG_UPLOAD_FREE_LOCAL=true

BVG_DRIVE_UPLOAD_CONCURRENCY=8

# ⚠ Google caps ONE user — a service account counts as a user — at **750 GB
# per rolling 24 hours** of data moved into Drive. Uploads and server-side
# copies BOTH count. Past it, every write comes back
# `403 userRateLimitExceeded`, which reads like a permission error and is not
# one. See the "Drive's 750 GB/day ceiling" section of README.md.

# Chunk size for uploads, in bytes. Must be a multiple of 256 KB. 8 MB (the
# old value, still used for downloads) means ~3,750 requests for a 30 GB
# archive, which is slow and invites rate limiting; 64 MB makes it ~480.
BVG_DRIVE_UPLOAD_CHUNK_BYTES=67108864

# How patiently a throttled Drive call is retried. The budget is per chunk, so
# a transfer that keeps making progress is never abandoned for being slow.
BVG_DRIVE_RETRY_ATTEMPTS=10
BVG_DRIVE_RETRY_MAX_SLEEP=120

# Pulling CTA clips FROM a Drive folder (Generate page → "3. CTA clips" → paste
# a folder link) instead of uploading them through the browser.
#
# The Shared Drive rule above does NOT apply to a source folder: reading uses
# nobody's storage quota, so a plain My Drive folder shared with the service
# account works fine. Viewer access is enough.
BVG_DRIVE_DOWNLOAD_CONCURRENCY=8

# Refuses a source folder holding more videos than this, rather than quietly
# using the first N of them.
BVG_DRIVE_MAX_SOURCE_FILES=5000

# ---------------------------------------------------------------- gemini
# Vertex AI on the project already running the VM, so the same service account
# is reused and there is no separate API key.
BVG_GCP_PROJECT=YOUR_PROJECT_ID
BVG_VERTEX_LOCATION=us-central1
BVG_GEMINI_POOL_MODEL=gemini-2.5-pro

# What the captions are about. This is the single biggest lever on their
# quality — be specific about the product and the audience.
BVG_CAPTION_THEME=

# Caption length. Derived from the 90-char filename budget: five hashtags eat
# ~38 of it, so ~50 is what a caption can occupy without being cut when it
# becomes a filename. Raising this means captions get truncated at naming time.
BVG_CAPTION_MAX_CHARS=50

BVG_CAPTION_POOL_SIZE=2000
BVG_HASHTAG_POOL_SIZE=500

# A pool is built in chunks of ~100, and the chunks are independent — so they
# run concurrently. Raising this shortens the wait but makes Vertex throttling
# more likely; throttled chunks are retried with backoff either way.
BVG_CAPTION_CONCURRENCY=8
BVG_CAPTION_MAX_ATTEMPTS=4

# Ceilings on the "how many to generate" inputs — not defaults. One caption per
# video and none reused, so a job of `batches x rows` videos needs that many:
# 1,000 rows across 16 promos is 16,000. Set high enough to be a typo guard
# rather than a real limit.
BVG_CAPTION_POOL_MAX=50000
BVG_HASHTAG_POOL_MAX=5000

# Emoji are stripped from captions AND filenames — removed when a caption is
# generated, and again when a filename is built. Set true to keep them.
BVG_FILENAME_KEEP_EMOJI=false

# ---------------------------------------------------------------- scraper
BVG_SCRAPE_MAX_VIDEOS=1500
BVG_SCRAPE_BATCH_SIZE=50
BVG_SCRAPE_SLOTS=5

# Every clip is cut to this window. Starting at 1s skips most creator intro
# branding and on-screen text, which would otherwise ride into your output.
BVG_SCRAPE_TRIM_START=1.0
BVG_SCRAPE_TRIM_DURATION=10.0

# ~1 clip per 1-2s. Faster than this gets the server's IP blocked.
BVG_SCRAPE_MIN_DELAY=1.0
BVG_SCRAPE_MAX_DELAY=2.0

# Optional Netscape-format cookies file. TikTok blocks datacenter IPs far more
# aggressively than home connections, so the VM may need a logged-in session
# even though a laptop does not.
BVG_SCRAPE_COOKIES_FILE=

# ------------------------------------------------------- scraper: audio
# TikTok reports acodec=aac on EVERY rendition it offers, including bytevc1
# (H.265) streams that arrive with no audio track at all — and yt-dlp's default
# codec preference ranks H.265 above H.264, so plain `best` picks the silent
# one. Nothing in the format metadata distinguishes them, so the download is
# checked afterwards and re-fetched with the selector below when it comes back
# mute. Banning H.265 outright is NOT the answer: on many posts its rendition
# is both fine and the only 720p on offer.
# BVG_SCRAPE_FORMAT=mp4/best
# BVG_SCRAPE_FORMAT_WITH_AUDIO=best[vcodec!*=h265][vcodec!*=hev]/best

# Set false to skip the audio check and its recovery re-download. Only sensible
# if you want footage and do not care about sound.
# BVG_SCRAPE_REQUIRE_AUDIO=true

# ------------------------------------------------- scraper: single-video tab
# The scraper page's "Single video" tab downloads one link straight to the
# browser — no job, no Drive. The file sits in JOBS_ROOT/_single/<session> until
# it is downloaded; nothing else reaps that path, so this is what clears it.
# BVG_SINGLE_FETCH_TTL_HOURS=6.0

# How many times one link is re-asked before giving up. TikTok's extraction is
# genuinely intermittent — the same link can download fine and then fail
# seconds later — and unlike a profile scrape there is no next run to catch it,
# so a single try would report "photo carousel or removed post" for videos that
# are neither.
# BVG_SINGLE_FETCH_ATTEMPTS=3
# BVG_SINGLE_FETCH_RETRY_DELAY=2.0
