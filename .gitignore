# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
.venv/
venv/
env/

# Streamlit
.streamlit/secrets.toml

# Environment & secrets
.env
.env.*
*.env
# ...but the template carries no secrets and should be committed
!.env.example

# Temporary / scratch files
_tmp_*.py
*.tmp
*.log

# Generated output
output/
outputs/
generated_videos/

# Background job storage (records, staged assets, rendered videos)
_jobs/

# Service-account keys — the VM uses ADC, but a local key may be mounted
*-key.json
service-account*.json

# Sample / test assets (keep the directory, ignore large media)
sample_assets/*.mp4
sample_assets/*.mov
sample_assets/*.avi

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.swp
*.swo

